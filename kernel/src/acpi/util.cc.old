#include <acpi/util.hh>
#include <cppcompat.hh>

namespace acpi {
	NameStore::NameStore() {
		entries = (entry*)vmm::alloc(capacity * sizeof(entry));
	}

	void NameStore::insert(u32 name, u8 valbytes, u32 value) {
		if (valbytes > 4 || !valbytes)
			fatal("valbytes ervenytelen: %d\n", valbytes);

		if (valbytes == 1)
			value &= 0xff;
		else if (valbytes == 2)
			value &= 0xffff;
		else if (valbytes == 3)
			value &= 0xffffff;

		new (&entries[size++]) entry(name, value, valbytes);
	}

	void NameStore::insert(u32 name, String& value) {
		new (&entries[size++]) entry(name, value);
		// entries[size++] = entry(name, value);
	}

	NameStore::entry& NameStore::byName(u32 name) {
		for (u32 i = 0; i < size; i++)
			if (entries[i].name == name)
				return entries[i];
		fatal("No such name: %s\n", (char*)&name);
	}

	inline NameStore::entry& NameStore::operator[](u32 idx) { return entries[idx]; }

	void NameStore::reserve(u32 cap) {
		capacity *= 4;
		entries = (entry*)vmm::realloc(entries, capacity * sizeof(entry));
	}

	NameStore::~NameStore() {
		vmm::free(entries);
	}
}
