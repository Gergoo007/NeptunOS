	assert(!bar5.io);
	u64 mmio = bar5.addr;

	volatile hba_regs* r = (hba_regs*)mmio;
	r->bohc |= 0b10; // assert os-owned
	arch_start_timer();
	while (r->bohc & 1) {
		if (arch_elapsed(10)) {
			warn("BIOS didn't release AHCI, forcing takeover...");
			r->bohc &= ~0b1;
			r->bohc |= 0b10;
			break;
		}
