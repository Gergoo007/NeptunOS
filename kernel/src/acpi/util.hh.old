#pragma once

#include <types.hh>
#include <util/storage.hh>

namespace acpi {
	struct DataObject {
		enum Type : u8 {
			BYTE,
			WORD,
			DWORD,
			QWORD,
			STRING,
		} type;

		union ValueUnion {
			u64 integer;
			// String string;
			const char* string;

			ValueUnion(u64 intval): integer(intval) {  }
			// ValueUnion(const char* s, u64 len): string(s, len) {  }
			ValueUnion(const char* s): string(s) {  }
			~ValueUnion() {  }
		} values;

		DataObject(Type t, u64 intval): type(t), values(intval) {  }
		// DataObject(Type t, const char* s, u64 len): values(s, len) {  }
		DataObject(Type t, const char* s): type(t), values(s) {  }
		~DataObject() {  }
	};

	// TODO: legyen sorted list vagy hashmap, a storage.hh-ból
	struct NameStore {
		struct entry {
			u32 name;
			union {
				u64 intval;
				const char* strval;
			} values;

			entry(u32 _name, u32 _intval, u8 _valbytes): name(_name), values(_intval), valbytes(_valbytes) {  }
			entry(u32 _name, const char* str): name(_name), valbytes(0) {
				values.strval = str;
			}
			~entry() {
				if (!valbytes)
					delete values.strval;
			}
		};

		entry* entries;
		u32 capacity = 128;
		u32 size = 0;

		NameStore();
		void insert(u32 name, u8 valbytes, u32 value);
		void insert(u32 name, const char* turi);
		entry& operator[](u32 name);
		entry& byName(u32 name);
		void reserve(u32 cap);
		~NameStore();
	};
}
